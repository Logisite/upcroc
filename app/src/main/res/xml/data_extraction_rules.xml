<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- OAuth tokens must not travel to another device via backup or D2D
         transfer. allowBackup="false" alone does not cover device transfer. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="upcroc.auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="upcroc.auth.xml" />
    </device-transfer>
</data-extraction-rules>
